# ── FORCE HTTPS REDIRECTION (PROXY SAFE) ──
RewriteEngine On
RewriteCond %{HTTPS} off [OR]
RewriteCond %{HTTP:X-Forwarded-Proto} =http
RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

# ── DISABLE DIRECTORY BROWSING ──
# Prevents users from viewing files in folders like public/assets/ directly
Options -Indexes
